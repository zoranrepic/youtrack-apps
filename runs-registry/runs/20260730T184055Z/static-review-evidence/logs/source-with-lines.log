=== src/widgets/github-action-tracker/app.tsx ===
     1	/* eslint-disable complexity, curly, no-void, react/jsx-wrap-multilines */
     2	import React, {memo, useEffect, useState} from 'react';
     3	
     4	const host = await YTApp.register();
     5	type PullRequest = {id: string; number?: number; title?: string; state?: string; url?: string; updated?: number; branch?: string};
     6	
     7	const AppComponent: React.FunctionComponent = () => {
     8	  const [pullRequests, setPullRequests] = useState<PullRequest[]>([]);
     9	  const [error, setError] = useState('');
    10	
    11	  useEffect(() => {
    12	    const issueId = YTApp.entity?.id;
    13	    if (!issueId) return;
    14	    const load = async () => {
    15	      try {
    16	        const issue = await host.fetchYouTrack(`issues/${issueId}`, {
    17	          query: {fields: 'id,pullRequests(id,number,title,state,url,updated,branch)'}
    18	        }) as {pullRequests?: PullRequest[]};
    19	        setPullRequests((issue.pullRequests || []).filter((pr) => (pr.title || '').includes(issueId)));
    20	      } catch {
    21	        setError('Unable to load linked pull requests.');
    22	      }
    23	    };
    24	    void load();
    25	  }, []);
    26	
    27	  return <section className="widget"><h3>{'GitHub Action Tracker'}</h3><p className="hint">{'Pull requests linked to this issue whose title includes the issue ID, with their latest tracked status.'}</p>
    28	    {error && <p className="error">{error}</p>}
    29	    {!error && pullRequests.length === 0 && <p>{'No linked pull requests found.'}</p>}
    30	    {pullRequests.map((pr) => <article className="card" key={pr.id}><div><strong>{pr.number ? `#${pr.number}` : pr.id}</strong>{' '}{pr.title || 'Pull request'}</div><span className={`status ${String(pr.state || 'unknown').toLowerCase()}`}>{pr.state || 'Unknown'}</span><small>{pr.branch ? `Branch: ${pr.branch}` : 'No branch details'}{pr.updated ? ` · Last tracked: ${new Date(pr.updated).toLocaleString()}` : ''}</small>{pr.url && <a href={pr.url} target="_blank" rel="noreferrer">{'Open pull request'}</a>}</article>)}
    31	  </section>;
    32	};
    33	export const App = memo(AppComponent);
