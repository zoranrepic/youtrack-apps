     1	/* eslint-disable @typescript-eslint/no-require-imports, complexity, no-magic-numbers, no-console */
     2	const entities = require('@jetbrains/youtrack-scripting-api/entities');
     3	
     4	exports.httpHandler = {
     5	  endpoints: [
     6	    {
     7	      method: 'POST',
     8	      path: 'time-entry',
     9	      scope: 'GLOBAL',
    10	      permissions: ['UPDATE_ISSUE'],
    11	      handle: (ctx) => {
    12	        const entry = ctx.request.json();
    13	        const issueId = entry && entry.issueId;
    14	        const minutes = Number(entry && entry.minutes);
    15	        const description = String((entry && entry.description) || 'Logged with Issue Delivery Control Center').trim();
    16	        const issue = issueId && entities.Issue.findById(issueId);
    17	
    18	        if (!issue || !issue.isVisibleTo(ctx.currentUser)) {
    19	          ctx.response.code = 404;
    20	          ctx.response.json({error: 'Issue not found or not visible.'});
    21	          return;
    22	        }
    23	        if (!Number.isInteger(minutes) || minutes < 1 || minutes > 1440) {
    24	          ctx.response.code = 400;
    25	          ctx.response.json({error: 'Minutes must be an integer between 1 and 1440.'});
    26	          return;
    27	        }
    28	
    29	        const workItemType = entities.WorkItemType.findByProject(issue.project).first();
    30	        if (!workItemType) {
    31	          ctx.response.code = 400;
    32	          ctx.response.json({error: 'The issue project has no available work-item type.'});
    33	          return;
    34	        }
    35	
    36	        issue.addWorkItem({
    37	          description,
    38	          date: Date.now(),
    39	          author: ctx.currentUser,
    40	          duration: minutes,
    41	          type: workItemType
    42	        });
    43	        console.info('Logged work item', issue.id, minutes);
    44	        ctx.response.json({issueId: issue.id, minutes, status: 'saved'});
    45	      }
    46	    }
    47	  ]
    48	};
