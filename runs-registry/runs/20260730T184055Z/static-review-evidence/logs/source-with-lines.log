    13	exports.rule = entities.Issue.onSchedule({
    14	  title: 'Monitor critical spent-time threshold',
    15	  search: 'has: {Spent time}',
    16	  cron: '0 * * * * ?', // every minute
    17	  guard: (ctx) => ctx.issue.isReported && (ctx.settings.criticalTimeLimitMinutes || 0) > 0,
    18	  action: (ctx) => {
    19	    const limit = ctx.settings.criticalTimeLimitMinutes;
    20	    const spent = totalMinutes(ctx.issue);
    21	    const percent = Math.round((spent / limit) * 100);
    22	    const state = spent >= limit ? 'critical' : percent >= 80 ? 'warning' : 'normal';
    23	    const previousState = ctx.issue.extensionProperties.criticalTimeAlertState;
    24	
    25	    if (previousState === state) return;
    26	
    27	    ctx.issue.extensionProperties.criticalTimeAlertState = state;
    28	    console.info('Critical time status changed', ctx.issue.id, state, spent, limit);
    29	
    30	    if (state !== 'normal' && ctx.settings.notificationEmail) {
    31	      notifications.sendEmail({
    32	        fromName: 'Issue Delivery Control Center',
    33	        to: [ctx.settings.notificationEmail],
    34	        subject: `[${state.toUpperCase()}] ${ctx.issue.id} is at ${percent}% of its time limit`,
    35	        body: `${ctx.issue.id}: ${ctx.issue.summary}\nSpent: ${spent} minutes\nLimit: ${limit} minutes\nStatus: ${state}`
    36	      }, ctx.issue);
    37	    }
    38	  },
    39	  requirements: {}
    40	});
