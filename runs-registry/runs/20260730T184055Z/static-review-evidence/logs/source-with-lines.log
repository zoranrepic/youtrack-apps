     1	/* eslint-disable curly, no-void, react/jsx-wrap-multilines, react/jsx-tag-spacing */
     2	import React, {memo, useEffect, useState} from 'react';
     3	import Button from '@jetbrains/ring-ui-built/components/button/button';
     4	
     5	const host = await YTApp.register();
     6	type Issue = {id: string; summary: string};
     7	
     8	const AppComponent: React.FunctionComponent = () => {
     9	  const [issues, setIssues] = useState<Issue[]>([]);
    10	  const [issueId, setIssueId] = useState('');
    11	  const [minutes, setMinutes] = useState('30');
    12	  const [description, setDescription] = useState('');
    13	  const [message, setMessage] = useState('');
    14	
    15	  useEffect(() => {
    16	    const load = async () => {
    17	      const result = await host.fetchYouTrack('issues', {query: {query: 'for: me', fields: 'id,summary', $top: 100}}) as Issue[];
    18	      setIssues(result);
    19	    };
    20	    void load().catch(() => setMessage('Unable to load issues available to you.'));
    21	  }, []);
    22	
    23	  const save = async () => {
    24	    setMessage('');
    25	    try {
    26	      const result = await host.fetchApp('time-tracking-global/time-entry', {method: 'POST', body: {issueId, minutes: Number(minutes), description}}) as {status?: string; error?: string};
    27	      setMessage(result.status === 'saved' ? `Saved ${minutes} minutes to ${issueId}.` : result.error || 'Unable to save time.');
    28	      if (result.status === 'saved') setDescription('');
    29	    } catch {
    30	      setMessage('Unable to save time. Verify the selected issue and permissions.');
    31	    }
    32	  };
    33	
    34	  return <section className="widget page"><h2>{'Global Time Logger'}</h2><p className="hint">{'Select an issue, enter spent time, and save a work item.'}</p>
    35	    <label>{'Issue'}<select value={issueId} onChange={(event) => setIssueId(event.target.value)}><option value="">{'Select an issue'}</option>{issues.map((issue) => <option key={issue.id} value={issue.id}>{`${issue.id} — ${issue.summary}`}</option>)}</select></label>
    36	    <label>{'Minutes'}<input type="number" min="1" max="1440" value={minutes} onChange={(event) => setMinutes(event.target.value)} /></label>
    37	    <label>{'Work description'}<input value={description} onChange={(event) => setDescription(event.target.value)} placeholder="What did you work on?" /></label>
    38	    <Button primary disabled={!issueId || !minutes} onClick={save}>{'Log time'}</Button>{message && <p className="message">{message}</p>}
    39	  </section>;
    40	};
    41	export const App = memo(AppComponent);
=== src/widgets/issue-relation-visualizer/app.tsx ===
     1	/* eslint-disable complexity, curly, no-void, react/jsx-wrap-multilines */
     2	import React, {memo, useEffect, useState} from 'react';
     3	
     4	const host = await YTApp.register();
     5	
     6	type Issue = {id: string; summary?: string};
     7	
     8	type IssueData = {id: string; summary: string; links?: Record<string, Issue[]>};
     9	
    10	const AppComponent: React.FunctionComponent = () => {
    11	  const [issue, setIssue] = useState<IssueData | null>(null);
    12	  const [error, setError] = useState('');
    13	
    14	  useEffect(() => {
    15	    const issueId = YTApp.entity?.id;
    16	    if (!issueId) return;
    17	    const load = async () => {
    18	      try {
    19	        const data = await host.fetchYouTrack(`issues/${issueId}`, {
    20	          query: {fields: 'id,summary,links(direction,linkType(name),issues(id,summary))'}
    21	        }) as IssueData;
    22	        setIssue(data);
    23	      } catch {
    24	        setError('Unable to load issue relations.');
    25	      }
    26	    };
    27	    void load();
    28	  }, []);
    29	
    30	  const relations = Object.entries(issue?.links || {});
    31	  return <section className="widget"><h3>{'Issue Relation Visualizer'}</h3>{error && <p className="error">{error}</p>}
    32	    {!issue && !error && <p>{'Loading relation graph…'}</p>}
    33	    {issue && <div className="graph"><div className="node primary">{issue.id}<small>{issue.summary}</small></div>
    34	      {relations.length === 0 ? <p>{'No linked issues.'}</p> : relations.map(([relation, items]) => <div className="relation" key={relation}><strong>{relation}</strong><div className="edges">{items.map((item) => <div className="node" key={item.id}><span>{'↔'}</span>{item.id}<small>{item.summary || 'Linked issue'}</small></div>)}</div></div>)}
    35	    </div>}</section>;
    36	};
    37	export const App = memo(AppComponent);
